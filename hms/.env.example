# Local development template. Copy to hms/.env and fill in.
# Production values are set in the Render dashboard, not here.

SECRET_KEY=generate-with-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
TIME_ZONE=Asia/Dhaka

# Omit to use the local SQLite file. Render injects this automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname
