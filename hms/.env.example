# Local development template. Copy to hms/.env and fill in.
# Production values are set in the Render dashboard, not here.

SECRET_KEY=generate-with-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
TIME_ZONE=Asia/Dhaka

# Omit to use the local SQLite file. Render injects this automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional security settings; docs/DEPLOYMENT.md explains each one.
# CACHE_URL=dbcache://hms_cache
# LOGIN_LOCKOUT_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# NUM_PROXIES=1
# ADMIN_URL=admin/
# API_DOCS_PUBLIC=False
# FRONTEND_URL=http://localhost:5173

# Lets seed_demo run with DEBUG off. Never on a deployment with real patient data.
# DEMO_MODE=False
